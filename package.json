{
  "name": "claimable",
  "version": "0.1.0",
  "description": "Tells you whether a GitHub issue is actually claimable — not just whether it says \"unassigned\".",
  "type": "module",
  "bin": {
    "claimable": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "compare": "node test/compare.ts",
    "record": "node test/record.ts",
    "check": "node --experimental-strip-types --check src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "github",
    "good-first-issue",
    "open-source",
    "triage",
    "contributing"
  ],
  "license": "MIT"
}
